# Copy this file to .env for local development. Values below are synthetic names only.
# Never put a real owner identity, provider response, token, credential, or production URL here.
BESTEHEN_APP_ENV=local
BESTEHEN_RELEASE_COMMIT=local-development
BESTEHEN_RELEASE_DIRTY=true
BESTEHEN_SCHEMA_MIN_REVISION=20260825_040_p03_foundation
BESTEHEN_SCHEMA_MAX_REVISION=20260825_040_p03_foundation
BESTEHEN_WEB_PORT=3000
BESTEHEN_WORKER_PORT=3001
BESTEHEN_SHUTDOWN_GRACE_MS=5000
BESTEHEN_LOG_LEVEL=info
BESTEHEN_LOG_FORMAT=json
DATABASE_URL=postgresql://bestehen_local:bestehen_local@127.0.0.1:5432/bestehen_local

# Fake adapters are the safe default. Productive environments refuse these values.
BESTEHEN_AUTH_ADAPTER=fake
BESTEHEN_OBJECT_STORAGE_ADAPTER=fake
BESTEHEN_EMAIL_ADAPTER=fake
BESTEHEN_AI_ADAPTER=fake
BESTEHEN_STT_ADAPTER=fake
BESTEHEN_TTS_ADAPTER=fake

# Personal-profile admission and productive capabilities remain closed.
BESTEHEN_FLAG_GUEST_PRESENTATION=false
BESTEHEN_FLAG_ACCOUNT_OPTIONAL_PRESENTATION=false
BESTEHEN_FLAG_EXTERNAL_PROVIDER_CALLS=false
BESTEHEN_FLAG_PAID_PRODUCTIVE_PROCESSING=false
BESTEHEN_FLAG_PUBLIC_OBJECT_ACCESS=false
BESTEHEN_FLAG_EXPERIMENTAL_PRODUCT_BEHAVIOR=false

# Server-only provider variables. Leave unset while the corresponding adapter is fake.
# Adapter values are auth0, r2, ses, gemini, and openai only when their complete group exists.
# BESTEHEN_AUTH0_ISSUER_BASE_URL=https://synthetic.eu.auth0.com
# BESTEHEN_AUTH0_CLIENT_ID=synthetic-client-identifier
# BESTEHEN_AUTH0_CLIENT_SECRET=secret-reference-only
# BESTEHEN_AUTH0_SESSION_SECRET=secret-reference-only
# BESTEHEN_AUTH0_OWNER_ALLOWLIST_REFERENCE=protected-ledger-reference
# BESTEHEN_APPLICATION_BASE_URL=https://staging.example.invalid
# BESTEHEN_AUTH0_CONNECTION=email
# BESTEHEN_AUTH0_CALLBACK_PATH=/auth/callback
# BESTEHEN_AUTH0_SESSION_POLICY_REVISION=session-policy/v1
# BESTEHEN_S3_ENDPOINT=https://synthetic.eu.r2.cloudflarestorage.com
# BESTEHEN_S3_REGION=auto
# BESTEHEN_S3_BUCKET=bestehen-staging-media
# BESTEHEN_S3_ALLOWED_PREFIXES=media/approved/,audio/raw/,exports/,tmp/
# BESTEHEN_S3_ACCESS_KEY_ID=secret-reference-only
# BESTEHEN_S3_SECRET_ACCESS_KEY=secret-reference-only
# BESTEHEN_SES_REGION=eu-central-1
# BESTEHEN_SES_FROM_REFERENCE=protected-ledger-reference
# BESTEHEN_SES_CONFIGURATION_SET=bestehen-staging
# BESTEHEN_SES_ACCESS_KEY_ID=secret-reference-only
# BESTEHEN_SES_SECRET_ACCESS_KEY=secret-reference-only
# BESTEHEN_GEMINI_MODEL=gemini-3.6-flash
# BESTEHEN_GEMINI_API_KEY=secret-reference-only
# BESTEHEN_OPENAI_STT_MODEL=gpt-4o-mini-transcribe-2025-12-15
# BESTEHEN_OPENAI_STT_API_KEY=secret-reference-only
# BESTEHEN_OPENAI_TTS_MODEL=gpt-4o-mini-tts-2025-12-15
# BESTEHEN_OPENAI_TTS_API_KEY=secret-reference-only

# Required as one complete, positive, owner-verified group before paid processing can be true.
# BESTEHEN_PAID_DAILY_ENVELOPE_MICRO_USD=<owner-set-positive-micro-usd>
# BESTEHEN_PAID_ROLLING_30D_ENVELOPE_MICRO_USD=<owner-set-positive-micro-usd>
# BESTEHEN_PAID_ENVELOPE_POLICY_REVISION=<owner-set-policy-revision>
# BESTEHEN_PAID_ENVELOPE_VERIFIED_AT=<last-verified-YYYY-MM-DD>
