        "P02-CONFIG-001",
        "P02-FAKE-001",
        "P02-SECRET-001",
        "P02-READINESS-001",
        "P02-DEPS-001",
        "P02-COMPAT-001",
        "P03-DOMAIN-001",
        "P03-SCHEMA-001",
        "P03-IDEMPOTENCY-001",
        "P03-JOB-001",
        "P03-EVIDENCE-001",
        "P03-IDENTITY-001",
        "P03-SESSION-001",
        "P03-AUTHZ-001",
        "P03-CONTRACT-001",
        "P03-AUDIT-001",
        "P03-COMPAT-001",
        "P03-SCOPE-001"
      ],
      "properties": {
        "P01-BASE-001": { "type": "string", "minLength": 1 },
        "P01-SCOPE-001": { "type": "string", "minLength": 1 },
        "P01-DEPS-001": { "type": "string", "minLength": 1 },
        "P01-BOUNDARY-001": { "type": "string", "minLength": 1 },
        "P01-TYPE-001": { "type": "string", "minLength": 1 },
        "P01-STYLE-001": { "type": "string", "minLength": 1 },
        "P01-UNIT-001": { "type": "string", "minLength": 1 },
        "P01-CONFIG-001": { "type": "string", "minLength": 1 },
        "P01-SECRET-001": { "type": "string", "minLength": 1 },
        "P01-PG-001": { "type": "string", "minLength": 1 },
        "P01-JOB-001": { "type": "string", "minLength": 1 },
