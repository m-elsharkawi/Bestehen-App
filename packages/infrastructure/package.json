    "@bestehen/configuration": "workspace:*",
    "@bestehen/contracts": "workspace:*",
    "@bestehen/domain": "workspace:*",
    "kysely": "0.29.5",
    "pg": "8.23.0",
    "pg-boss": "12.27.0"
  },
  "devDependencies": {
    "@bestehen/test-support": "workspace:*",
    "@types/pg": "8.23.1",
    "tsx": "4.23.12"
  }
