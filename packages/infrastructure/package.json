{
  "name": "@bestehen/infrastructure",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "default": "./dist/postgres/index.js"
    }
  },
  "files": [
    "dist"
