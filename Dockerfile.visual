# syntax=docker/dockerfile:1.7
# This image is the sole raster environment for P04-VISUAL-001 baseline updates and
# comparisons. Keep the Node base digest, pnpm version, and Playwright lock entry
# aligned with package.json/pnpm-lock.yaml.
FROM node:24.19.0-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df

WORKDIR /workspace
ENV COREPACK_HOME=/corepack \
    NEXT_TELEMETRY_DISABLED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH

RUN corepack enable && corepack prepare pnpm@11.23.0 --activate
RUN touch /etc/bestehen-visual-raster
COPY . .
RUN pnpm install --frozen-lockfile && \
    pnpm build && \
    pnpm exec playwright install --with-deps chromium

CMD ["pnpm", "test:visual"]
