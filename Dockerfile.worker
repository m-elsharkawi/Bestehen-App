# syntax=docker/dockerfile:1.7
FROM node:24.19.0-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df AS build
WORKDIR /workspace
ENV COREPACK_HOME=/corepack \
    PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH
RUN corepack enable && corepack prepare pnpm@11.23.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm build
RUN pnpm --filter @bestehen/worker deploy --prod /runtime

FROM node:24.19.0-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df AS runtime
ARG OCI_CREATED
ARG OCI_REVISION
LABEL org.opencontainers.image.created=$OCI_CREATED \
      io.bestehen.runtime.node="24.19.0" \
      io.bestehen.runtime.pnpm="11.23.0" \
      org.opencontainers.image.licenses="UNLICENSED" \
      org.opencontainers.image.revision=$OCI_REVISION \
      org.opencontainers.image.source="https://github.com/m-elsharkawi/Bestehen-App" \
      org.opencontainers.image.title="Bestehen worker" \
      org.opencontainers.image.version="stage-01"
ENV HOME=/tmp \
    NODE_ENV=production
WORKDIR /app
RUN groupadd --gid 10001 bestehen && \
    useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin bestehen
COPY --from=build --chown=10001:10001 /runtime ./
COPY --chown=10001:10001 scripts/healthcheck.mjs /app/healthcheck.mjs
USER 10001:10001
EXPOSE 3001
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD ["node", "/app/healthcheck.mjs", "3001", "/health/live"]
STOPSIGNAL SIGTERM
CMD ["node", "dist/main.js"]
