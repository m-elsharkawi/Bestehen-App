{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@bestehen/application": ["packages/application/dist/index.js"],
      "@bestehen/configuration": ["packages/configuration/dist/index.js"],
      "@bestehen/contracts": ["packages/contracts/dist/index.js"],
      "@bestehen/design-system": ["packages/design-system/dist/index.js"],
      "@bestehen/design-system/styles.css": ["packages/design-system/src/styles.css"],
      "@bestehen/infrastructure": ["packages/infrastructure/dist/index.js"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", ".next/types/**/*.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}
