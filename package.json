{
  "name": "bestehen-app",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.23.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm check:scope && pnpm check:lock && pnpm check:secrets && pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:boundaries && pnpm test:unit && pnpm test:release && pnpm build && pnpm check:generated",
    "check:boundaries": "dependency-cruiser --config dependency-cruiser.cjs apps packages && node scripts/check-boundaries.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:full": "pnpm check && pnpm test:integration && pnpm test:process && pnpm test:e2e && pnpm test:oci && pnpm check:docs",
    "check:generated": "node scripts/check-generated.mjs",
    "check:lock": "node scripts/check-lock-policy.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:scope": "node scripts/check-scope.mjs",
    "db:migrate": "node scripts/run-with-local-env.mjs pnpm --filter @bestehen/infrastructure db:migrate",
    "dev": "node scripts/run-with-local-env.mjs pnpm --parallel --filter @bestehen/web --filter @bestehen/worker dev",
    "dev:web": "node scripts/run-with-local-env.mjs pnpm --filter @bestehen/web dev",
    "dev:worker": "node scripts/run-with-local-env.mjs pnpm --filter @bestehen/worker dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "release:manifest": "node scripts/release-manifest.mjs",
    "test": "pnpm test:unit",
    "test:coverage": "vitest --run --config vitest.workspace.ts --project unit --coverage",
    "test:e2e": "playwright test",
    "test:integration": "vitest --run --config vitest.workspace.ts --project integration",
    "test:oci": "node scripts/test-oci.mjs",
    "test:process": "vitest --run --config vitest.workspace.ts --project process",
    "test:release": "node scripts/test-release-manifest.mjs",
    "test:unit": "vitest --run --config vitest.workspace.ts --project unit",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.11",
    "@biomejs/biome": "2.5.10",
    "dependency-cruiser": "18.2.0",
    "fast-check": "4.9.0",
    "jsdom": "30.0.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
